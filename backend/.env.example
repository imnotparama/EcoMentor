# ==============================================================
# EcoMentor AI — Backend Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================

# Anthropic Claude API key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SQLite (dev) or PostgreSQL (prod) database URL
DATABASE_URL=sqlite:///./ecomentorAI.db
# For PostgreSQL: postgresql://user:password@host:5432/ecomentorAI

# JWT secret key — generate with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_in_production

# JWT algorithm (do not change)
ALGORITHM=HS256

# Access token lifetime in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Environment (development | production)
ENVIRONMENT=development
